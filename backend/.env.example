# ==========================================
# SV-MINE BACKEND CONFIGURATION
# ==========================================

# Server port and environment
PORT=3001
NODE_ENV=production
JWT_SECRET=super_secret_jwt_key_change_me_in_production
ALLOWED_ORIGIN=https://middleT0108.github.io,http://localhost:5173

# SQLite database file path
DATABASE_PATH=./data/sv_mine.sqlite

# Directory where Minecraft server data volumes and backups reside
MC_DATA_DIR=/var/minecraft/servers
MC_BACKUP_DIR=/var/minecraft/backups
MC_ROUTER_ROUTES_FILE=/var/minecraft/router/routes.json

# Maximum backups to retain per server before pruning old ones
MAX_BACKUP_COPIES=3

# Host server Public IP or Domain
HOST_PUBLIC_IP=140.238.xxx.xxx

# DuckDNS Configuration
DUCKDNS_TOKEN=your-duckdns-token-here
DUCKDNS_BASE_DOMAIN=duckdns.org

# Server limits per user account to prevent resource exhaustion
MAX_SERVERS_PER_USER=2
MAX_RAM_MB_PER_SERVER=6144
DEFAULT_RAM_MB=3072

# Docker Socket Path
DOCKER_SOCKET=/var/run/docker.sock
